# =========================================================================
# OpenSlot AI environment variables. Copy to .env.local and fill in real values.
# =========================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clinic (single-tenant for now; receptionist dashboard targets this id) ---
CLINIC_ID=59f9d6c2-a9d2-4817-ae73-40b36cb5a9fd

# --- Token encryption (32-byte hex; generate with: openssl rand -hex 32) ---
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (https://console.cloud.google.com -> APIs & Services) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# --- Fonio (https://app.fonio.ai -> API) ---
# Leave USE_MOCK_FONIO=true to keep the dispatcher running without real Fonio
# credentials. Flip to false (or unset) once you have an account.
USE_MOCK_FONIO=true
FONIO_API_KEY=
FONIO_BASE_URL=https://app.fonio.ai/api
# Coflaz-style names (kept for backwards compatibility):
FONIO_ASSISTANT_ID=
FONIO_OUTBOUND_NUMBER_ID=
# final-style names (aliases of the above; either pair works):
FONIO_AGENT_ID=
FONIO_FROM_NUMBER=
FONIO_WEBHOOK_TOKEN=
FONIO_CLINIC_NAME=OpenSlot Medical

# --- App base URL (used to build webhook callback URLs) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
