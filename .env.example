# =========================================================================
# OpenSlot AI environment variables. Copy to .env.local and fill in real values.
# =========================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Token encryption (32-byte hex; generate with: openssl rand -hex 32) ---
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (https://console.cloud.google.com → APIs & Services) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# --- Fonio (https://app.fonio.ai → API) ---
# Set USE_MOCK_FONIO=true to keep the cascade demo running without a real Fonio account.
USE_MOCK_FONIO=true
FONIO_API_KEY=
FONIO_BASE_URL=https://app.fonio.ai/api
FONIO_ASSISTANT_ID=
FONIO_OUTBOUND_NUMBER_ID=
FONIO_WEBHOOK_TOKEN=

# --- App base URL (used to build webhook callback URLs) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
